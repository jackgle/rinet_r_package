# .gitignore for R packages
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj

# Python/Keras related
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/

# Model files (optional - uncomment if you don't want to track large model files)
# *.keras
# *.h5

# OS files
.DS_Store
Thumbs.db

.claude/
# Local analysis and model staging (not part of the package)
benchmark/
inst/models/tmp/
